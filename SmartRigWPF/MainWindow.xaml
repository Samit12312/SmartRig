<Window x:Class="SmartRigWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartRig"
        Height="650"
        Width="1100"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkMain}">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/wpf-background.jpg"
                        Stretch="UniformToFill"
                        Opacity="0.28"/>
        </Grid.Background>

        <Rectangle Fill="#B0080D18"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#EE070D18"
                    BorderBrush="#F97316"
                    BorderThickness="0,0,0,3">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="90"
                                Height="48"
                                CornerRadius="9"
                                ClipToBounds="True"
                                Background="#111827">
                            <Image Source="/Images/Mundo.png"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <Button Content="Home"
                                x:Name="HomeButton"
                                Width="90"
                                Height="38"
                                Margin="16,0,0,0"
                                Click="HomePage_Click"
                                Background="Transparent"
                                BorderBrush="#334155"
                                Foreground="White"/>
                    </StackPanel>

                    <!-- CENTER TITLE -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="SmartRig Admin"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Manage users, computers, orders and reports"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- RIGHT -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <TextBlock x:Name="HelloText"
                                   Text=""
                                   Foreground="{StaticResource TextSoft}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"
                                   Visibility="Collapsed"/>

                        <Button x:Name="LoginButton"
                                Content="Login"
                                Width="90"
                                Height="38"
                                Click="Login_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY -->
            <Grid Grid.Row="1" Margin="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideBarColumn" Width="230"/>
                    <ColumnDefinition x:Name="ContentColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        x:Name="SideBarBorder"
                        Background="#DD101B2D"
                        BorderBrush="#314158"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14"
                        Margin="0,0,18,0">

                    <StackPanel x:Name="SideBar" Visibility="Visible">

                        <TextBlock Text="Navigation"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="6,4,0,14"/>

                        <Button Content="Dashboard"
                                x:Name="DashBoard"
                                Style="{StaticResource NavButtonStyle}"
                                Click="HomePage_Click"/>

                        <Button Content="Manage Users"
                                x:Name="UsersButton"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,8,0,0"
                                Click="Button_Click_4"/>

                        <Button Content="Manage Computers"
                                x:Name="ComputersButton"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,8,0,0"
                                Click="Button_Click_3"/>

                        <Button Content="Manage Components"
                                x:Name="ComponentsButton"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,8,0,0"
                                Click="Button_Click_2"/>

                        <Button Content="Manage Orders"
                                x:Name="OrdersButton"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,8,0,0"
                                Click="Button_Click_1"/>

                        <Button Content="Manage Reports"
                                x:Name="ReportsButton"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,8,0,0"
                                Click="Button_Click"/>
                    </StackPanel>
                </Border>

                <!-- CONTENT AREA -->
                <Border Grid.Column="1"
                        Background="#DD101B2D"
                        BorderBrush="#314158"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">

                    <Frame x:Name="ContentFrame"
                           NavigationUIVisibility="Hidden"
                           Background="Transparent"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>