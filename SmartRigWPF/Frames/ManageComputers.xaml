<UserControl x:Class="SmartRigWPF.Frames.ManageComputers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartRigWPF"
             Background="Transparent">

    <UserControl.Resources>
        <local:ImageUrlToBitmapConverter x:Key="ImageConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Manage Computers"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   Text="Add, edit and remove computers from the catalog"
                   FontSize="14"
                   Foreground="{StaticResource TextMuted}"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">

                <Button Content="Add Computer"
                        Width="135"
                        Click="Button_Click"/>

                <Button Content="Edit Computer"
                        Width="135"
                        Margin="12,0,0,0"
                        Background="#2563EB"
                        BorderBrush="#60A5FA"
                        Click="EditBtn_Click"/>

                <Button Content="Delete Computer"
                        Width="145"
                        Margin="12,0,0,0"
                        Background="{StaticResource Red}"
                        BorderBrush="#F87171"
                        Click="Button_Click_1"/>
            </StackPanel>

            <ListView x:Name="listView"
                      Grid.Row="1"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#CC162235"
                                BorderBrush="#314158"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,10">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding computer.ComputerName}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,3,0,10">
                                        <Run Text="Computer ID: "/>
                                        <Run Text="{Binding computer.ComputerId}"/>
                                    </TextBlock>

                                    <UniformGrid Columns="2" Margin="0,2,0,0">
                                        <TextBlock Foreground="{StaticResource TextSoft}" Text="{Binding cpu.CpuName, StringFormat=CPU: {0}}"/>
                                        <TextBlock Foreground="{StaticResource TextSoft}" Text="{Binding gpu.GpuName, StringFormat=GPU: {0}}"/>
                                        <TextBlock Foreground="{StaticResource TextSoft}" Text="{Binding ram.RamSize, StringFormat=RAM: {0}}"/>
                                        <TextBlock Foreground="{StaticResource TextSoft}" Text="{Binding storage.StorageName, StringFormat=Storage: {0}}"/>
                                        <TextBlock Foreground="{StaticResource TextSoft}" Text="{Binding operatingSystem.OperatingSystemName, StringFormat=OS: {0}}"/>
                                        <TextBlock Foreground="{StaticResource Green}" FontWeight="Bold" Text="{Binding computer.Price, StringFormat=Price: ₪{0:N0}}"/>
                                    </UniformGrid>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#66111827"
                                        BorderBrush="#314158"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="14,0,0,0">
                                    <Image Source="{Binding computer.ComputerPicture, Converter={StaticResource ImageConverter}}"
                                           Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>