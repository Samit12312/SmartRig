<UserControl x:Class="SmartRigWPF.Frames.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Border Width="420"
                Height="360"
                Background="#EE101B2D"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Canvas>
                <TextBlock Canvas.Left="0"
                           Canvas.Top="35"
                           Width="420"
                           Text="Login"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"/>

                <TextBlock Canvas.Left="0"
                           Canvas.Top="78"
                           Width="420"
                           Text="Enter your admin account"
                           FontSize="13"
                           Foreground="#94A3B8"
                           TextAlignment="Center"/>

                <TextBlock Canvas.Left="45"
                           Canvas.Top="125"
                           Text="Email"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="EmailTextBox"
                         Canvas.Left="45"
                         Canvas.Top="148"
                         Width="330"
                         Height="34"
                         Padding="8,4"
                         FontSize="13"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"/>

                <TextBlock Canvas.Left="45"
                           Canvas.Top="195"
                           Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <PasswordBox x:Name="PasswordBox"
                             Canvas.Left="45"
                             Canvas.Top="218"
                             Width="330"
                             Height="34"
                             Padding="8,4"
                             FontSize="13"
                             Foreground="White"
                             Background="#CC111827"
                             BorderBrush="#475569"
                             BorderThickness="1"
                             CaretBrush="White"/>

                <Button Content="Login"
                        Canvas.Left="45"
                        Canvas.Top="275"
                        Width="330"
                        Height="38"
                        Background="#C2410C"
                        Foreground="White"
                        BorderBrush="#F97316"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Button_Click_2"/>

                <TextBlock Canvas.Left="0"
                           Canvas.Top="325"
                           Width="420"
                           Text="SmartRig Management System"
                           FontSize="12"
                           Foreground="#94A3B8"
                           TextAlignment="Center"/>
            </Canvas>
        </Border>
    </Grid>
</UserControl>