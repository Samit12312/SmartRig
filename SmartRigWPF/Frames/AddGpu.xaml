<Window x:Class="SmartRigWPF.Frames.AddGpu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#080D18"
        Title="Add GPU">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/wpf-background.jpg" Stretch="UniformToFill" Opacity="0.25"/>
        </Grid.Background>

        <Rectangle Fill="#CC080D18"/>

        <Border Width="390" Height="365"
                Background="#EE101B2D"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Canvas>
                <TextBlock Canvas.Left="25" Canvas.Top="20"
                           Text="GPU"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="70" Text="GPU Name" FontSize="13" Foreground="#CBD5E1"/>
                <TextBox x:Name="GpuNameBox" Canvas.Left="25" Canvas.Top="92" Width="330" Height="34" Padding="8,4" Foreground="White" Background="#CC111827" BorderBrush="#475569" CaretBrush="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="135" Text="Size" FontSize="13" Foreground="#CBD5E1"/>
                <TextBox x:Name="SizeBox" Canvas.Left="25" Canvas.Top="157" Width="150" Height="34" Padding="8,4" Foreground="White" Background="#CC111827" BorderBrush="#475569" CaretBrush="White"/>

                <TextBlock Canvas.Left="205" Canvas.Top="135" Text="Speed" FontSize="13" Foreground="#CBD5E1"/>
                <TextBox x:Name="SpeedBox" Canvas.Left="205" Canvas.Top="157" Width="150" Height="34" Padding="8,4" Foreground="White" Background="#CC111827" BorderBrush="#475569" CaretBrush="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="200" Text="Price" FontSize="13" Foreground="#CBD5E1"/>
                <TextBox x:Name="PriceBox" Canvas.Left="25" Canvas.Top="222" Width="150" Height="34" Padding="8,4" Foreground="White" Background="#CC111827" BorderBrush="#475569" CaretBrush="White"/>

                <TextBlock Canvas.Left="205" Canvas.Top="200" Text="Company" FontSize="13" Foreground="#CBD5E1"/>
                <ComboBox x:Name="CompanyBox" Canvas.Left="205" Canvas.Top="222" Width="150" Height="34" Padding="6,4" Foreground="#111827" Background="#E5EAF3" BorderBrush="#475569" DisplayMemberPath="CompanyName" SelectedValuePath="CompanyId"/>

                <Button x:Name="AddBtn" Canvas.Left="25" Canvas.Top="300" Content="Save" Width="135" Height="36" Background="#16A34A" Foreground="White" BorderBrush="#4ADE80" Click="AddBtn_Click"/>
                <Button x:Name="CancelBtn" Canvas.Left="175" Canvas.Top="300" Content="Cancel" Width="110" Height="36" Background="#DC2626" Foreground="White" BorderBrush="#F87171" Click="CancelBtn_Click"/>
            </Canvas>
        </Border>
    </Grid>
</Window>