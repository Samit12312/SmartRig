<Window x:Class="SmartRigWPF.Frames.AddCpu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#080D18"
        Title="Add CPU">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/wpf-background.jpg" Stretch="UniformToFill" Opacity="0.25"/>
        </Grid.Background>

        <Rectangle Fill="#CC080D18"/>

        <Border Width="360" Height="270"
                Background="#EE101B2D"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Canvas>
                <TextBlock Canvas.Left="25" Canvas.Top="20"
                           Text="CPU"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="70"
                           Text="CPU Name"
                           FontSize="13"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="CpuNameBox"
                         Canvas.Left="25" Canvas.Top="92"
                         Width="300" Height="34"
                         Padding="8,4"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         CaretBrush="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="135"
                           Text="Price"
                           FontSize="13"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="PriceBox"
                         Canvas.Left="25" Canvas.Top="157"
                         Width="140" Height="34"
                         Padding="8,4"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         CaretBrush="White"/>

                <TextBlock Canvas.Left="185" Canvas.Top="135"
                           Text="Company"
                           FontSize="13"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="CompanyBox"
                          Canvas.Left="185" Canvas.Top="157"
                          Width="140" Height="34"
                          Padding="6,4"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="CompanyName"
                          SelectedValuePath="CompanyId"/>

                <Button x:Name="AddBtn"
                        Canvas.Left="25" Canvas.Top="215"
                        Content="Save"
                        Width="135" Height="36"
                        Background="#16A34A"
                        Foreground="White"
                        BorderBrush="#4ADE80"
                        Click="AddBtn_Click"/>

                <Button x:Name="CancelBtn"
                        Canvas.Left="175" Canvas.Top="215"
                        Content="Cancel"
                        Width="110" Height="36"
                        Background="#DC2626"
                        Foreground="White"
                        BorderBrush="#F87171"
                        Click="CancelBtn_Click"/>
            </Canvas>
        </Border>
    </Grid>
</Window>