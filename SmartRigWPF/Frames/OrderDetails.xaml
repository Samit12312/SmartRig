<Window x:Class="SmartRigWPF.Frames.OrderDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Details"
        Height="620"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkMain}">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/wpf-background.jpg"
                        Stretch="UniformToFill"
                        Opacity="0.22"/>
        </Grid.Background>

        <Rectangle Fill="#CC080D18"/>

        <Border Margin="24"
                Background="#E6101B2D"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="20"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Order Details"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="View order information and update payment status"
                               FontSize="14"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#AA162235" BorderBrush="#314158" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Order ID" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Name="OrderIdText" Text="---" Foreground="White" FontWeight="Bold" FontSize="18"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#AA162235" BorderBrush="#314158" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="User ID" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Name="UserIdText" Text="---" Foreground="White" FontWeight="Bold" FontSize="18"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#AA162235" BorderBrush="#314158" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Date" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Name="DateText" Text="---" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#AA162235" BorderBrush="#314158" BorderThickness="1" CornerRadius="12" Padding="14">
                        <CheckBox Name="IsPayedBox"
                                  Content="Paid"
                                  VerticalAlignment="Center"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                    </Border>
                </Grid>

                <ListView Name="ComputersListView"
                          Grid.Row="2"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#CC162235"
                                    BorderBrush="#314158"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <TextBlock Text="{Binding ComputerName}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                    <TextBlock Text="{Binding Price, StringFormat=Price: ₪{0:N0}}"
                                               Foreground="{StaticResource Green}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">

                    <Button Name="SaveBtn"
                            Content="Save"
                            Width="120"
                            Click="SaveBtn_Click"
                            Background="#16A34A"
                            BorderBrush="#4ADE80"/>

                    <Button Name="CancelBtn"
                            Content="Cancel"
                            Width="120"
                            Margin="12,0,0,0"
                            Click="CancelBtn_Click"
                            Background="#DC2626"
                            BorderBrush="#F87171"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>