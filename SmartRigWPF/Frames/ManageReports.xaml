<UserControl x:Class="SmartRigWPF.Frames.ManageReports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Small text box inside the DatePicker -->
        <Style x:Key="ReportDatePickerTextBoxStyle"
               TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="5,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <ContentControl x:Name="PART_Watermark"
                                            Content="Select"
                                            Foreground="#64748B"
                                            FontSize="11"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small arrow button inside the DatePicker -->
        <Style x:Key="ReportCalendarButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <TextBlock Text="▼"
                                       Foreground="#111827"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main DatePicker Style -->
        <Style x:Key="ReportDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="#E5EAF3"/>
            <Setter Property="BorderBrush" Value="#314158"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                                  Grid.Column="0"
                                                                  Height="26"
                                                                  Style="{StaticResource ReportDatePickerTextBoxStyle}"/>

                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Style="{StaticResource ReportCalendarButtonStyle}"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False">

                                <Border Background="#F8FAFC"
                                        BorderBrush="#314158"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6">

                                    <Calendar x:Name="PART_Calendar"
                                              Background="#F8FAFC"
                                              Foreground="#111827"
                                              BorderThickness="0"
                                              Language="en-US">

                                        <!-- Month / Year / Decade buttons -->
                                        <Calendar.CalendarButtonStyle>
                                            <Style TargetType="{x:Type CalendarButton}">
                                                <Setter Property="Foreground" Value="#111827"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="6"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type CalendarButton}">
                                                            <Border x:Name="ButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Padding="6">

                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/>
                                                                    <Setter Property="Foreground" Value="#111827"/>
                                                                </Trigger>

                                                                <Trigger Property="IsInactive" Value="True">
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Calendar.CalendarButtonStyle>

                                        <!-- Days inside the calendar -->
                                        <Calendar.CalendarDayButtonStyle>
                                            <Style TargetType="{x:Type CalendarDayButton}">
                                                <Setter Property="Foreground" Value="#111827"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Width" Value="32"/>
                                                <Setter Property="Height" Value="26"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                                                            <Border x:Name="DayBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Margin="1">

                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="Background" Value="#DBEAFE"/>
                                                                    <Setter Property="Foreground" Value="#111827"/>
                                                                </Trigger>

                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="Background" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                </Trigger>

                                                                <Trigger Property="IsToday" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="#F97316"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                                                                </Trigger>

                                                                <Trigger Property="IsInactive" Value="True">
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Calendar.CalendarDayButtonStyle>

                                        <!-- Fixes the top header text and arrows in the DatePicker popup -->
                                        <Calendar.Resources>

                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#111827"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>

                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Foreground" Value="#111827"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="4"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="Height" Value="28"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Cursor" Value="Hand"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="CalendarHeaderButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">

                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CalendarHeaderButtonBorder" Property="Background" Value="#E2E8F0"/>
                                                                </Trigger>

                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="CalendarHeaderButtonBorder" Property="Background" Value="#CBD5E1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                        </Calendar.Resources>

                                    </Calendar>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenerateReportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Manage Reports"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="From:"
                           VerticalAlignment="Center"
                           Foreground="#CBD5E1"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <DatePicker Name="StartDatePicker"
                            Style="{StaticResource ReportDatePickerStyle}"
                            Margin="0,0,15,0"/>

                <TextBlock Text="To:"
                           VerticalAlignment="Center"
                           Foreground="#CBD5E1"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <DatePicker Name="EndDatePicker"
                            Style="{StaticResource ReportDatePickerStyle}"
                            Margin="0,0,15,0"/>

                <Button Content="Generate Report"
                        Style="{StaticResource GenerateReportButtonStyle}"
                        Click="Button_Click"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Background="#CC162235"
                Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="Total Income"
                           FontSize="15"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,5"/>

                <TextBlock Name="TotalIncomeText"
                           Text="₪0"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#22C55E"/>

                <TextBlock Name="DateRangeText"
                           Text="Select date range and click Generate Report"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Background="#CC162235">

            <StackPanel>
                <TextBlock Text="Most Selling Computer"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#314158"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="5"
                            Background="#66111827"
                            Width="100"
                            Height="100"
                            Margin="0,0,15,0">

                        <Image Name="MostSellingComputerImage"
                               Stretch="Uniform"
                               Source="/Images/Mundo.png"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,5">

                            <TextBlock Text="ID: "
                                       FontSize="12"
                                       Foreground="#CBD5E1"/>

                            <TextBlock Name="ComputerIdText"
                                       Text="---"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>

                        <TextBlock Name="ComputerNameText"
                                   Text="---"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                        <TextBlock Name="ComputerPriceText"
                                   Text="₪---"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#22C55E"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>