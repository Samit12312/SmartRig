<UserControl x:Class="SmartRigWPF.Frames.ManageComponents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Models.ViewModels;assembly=Models"
             Background="Transparent">

    <UserControl.Resources>

        <!-- CPU -->
        <DataTemplate DataType="{x:Type viewModels:CpuManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding cpu.CpuName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding cpu.CpuId, StringFormat=CPU ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding cpu.CpuPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- GPU -->
        <DataTemplate DataType="{x:Type viewModels:GpuManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding gpu.GpuName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding gpu.GpuId, StringFormat=GPU ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding gpu.GpuSize, StringFormat=Size: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding gpu.GpuSpeed, StringFormat=Speed: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding gpu.GpuPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- RAM -->
        <DataTemplate DataType="{x:Type viewModels:RamManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding ram.RamName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding ram.RamId, StringFormat=RAM ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding ram.RamSize, StringFormat=Size: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding ram.RamSpeed, StringFormat=Speed: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding type.TypeName, StringFormat=Type: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding ram.RamPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Storage -->
        <DataTemplate DataType="{x:Type viewModels:StorageManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding storage.StorageName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding storage.StorageId, StringFormat=Storage ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding storage.StorageSize, StringFormat=Size: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding storage.StorageSpeed, StringFormat=Speed: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding type.TypeName, StringFormat=Type: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding storage.StoragePrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Motherboard -->
        <DataTemplate DataType="{x:Type viewModels:MotherBoardManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding motherBoard.MotherBoardName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding motherBoard.MotherBoardId, StringFormat=Motherboard ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding motherBoard.MotherBoardPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Case -->
        <DataTemplate DataType="{x:Type viewModels:CaseManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding computerCase.CaseName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding computerCase.CaseId, StringFormat=Case ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding computerCase.CasePrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- CPU Fan -->
        <DataTemplate DataType="{x:Type viewModels:CpuFanManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding cpuFan.CpuFanName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding cpuFan.CpuFanId, StringFormat=CPU Fan ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding cpuFan.CpuFanPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Power Supply -->
        <DataTemplate DataType="{x:Type viewModels:PowerSupplyManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding powerSupply.PowerSupplyName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding powerSupply.PowerSupplyId, StringFormat=Power Supply ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding powerSupply.PowerSupplyWatt, StringFormat=Watt: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding powerSupply.PowerSupplyPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Operating System -->
        <DataTemplate DataType="{x:Type viewModels:OperatingSystemManageViewModel}">
            <Border Background="#CC162235"
                    BorderBrush="#314158"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,8"
                    Width="720">
                <StackPanel>
                    <TextBlock Text="{Binding operatingSystem.OperatingSystemName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="{Binding operatingSystem.OperatingSystemId, StringFormat=OS ID: {0}}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,8"/>

                    <TextBlock Text="{Binding company.CompanyName, StringFormat=Company: {0}}"
                               Foreground="#CBD5E1"/>

                    <TextBlock Text="{Binding operatingSystem.OperatingSystemPrice, StringFormat=Price: ₪{0:N0}}"
                               Foreground="#22C55E"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="10"
                       Canvas.Top="5"
                       Text="Manage Components"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Canvas.Left="10"
                       Canvas.Top="48"
                       Text="Add, edit and remove hardware parts"
                       FontSize="14"
                       Foreground="#94A3B8"/>

            <TextBlock Canvas.Left="10"
                       Canvas.Top="97"
                       Text="Filter:"
                       Foreground="#CBD5E1"
                       FontWeight="SemiBold"/>

            <ComboBox x:Name="ComponentTypeComboBox"
                      Canvas.Left="65"
                      Canvas.Top="90"
                      Width="165"
                      Height="36"
                      Foreground="#111827"
                      Background="#E5EAF3"
                      BorderBrush="#314158"
                      SelectionChanged="ComponentTypeComboBox_SelectionChanged">

                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="CPU"/>
                <ComboBoxItem Content="GPU"/>
                <ComboBoxItem Content="RAM"/>
                <ComboBoxItem Content="Storage"/>
                <ComboBoxItem Content="Motherboard"/>
                <ComboBoxItem Content="Case"/>
                <ComboBoxItem Content="CPU Fan"/>
                <ComboBoxItem Content="Power Supply"/>
                <ComboBoxItem Content="Operating System"/>
            </ComboBox>

            <Button Content="Add"
                    Canvas.Left="250"
                    Canvas.Top="90"
                    Width="110"
                    Height="36"
                    Background="#16A34A"
                    Foreground="White"
                    BorderBrush="#4ADE80"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="AddBtn_Click"/>

            <Button Content="Edit"
                    Canvas.Left="375"
                    Canvas.Top="90"
                    Width="110"
                    Height="36"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#60A5FA"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="EditBtn_Click"/>

            <Button Content="Delete"
                    Canvas.Left="500"
                    Canvas.Top="90"
                    Width="110"
                    Height="36"
                    Background="#DC2626"
                    Foreground="White"
                    BorderBrush="#F87171"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="DeleteBtn_Click"/>

            <ListView x:Name="listView"
                      Canvas.Left="10"
                      Canvas.Top="145"
                      Width="760"
                      Height="340"
                      Background="#99101B2D"
                      Foreground="White"
                      BorderBrush="#314158"
                      BorderThickness="1"
                      Padding="8"/>
        </Canvas>
    </Grid>
</UserControl>