<Window x:Class="SmartRigWPF.Frames.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Width="560"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#080D18"
        Title="Add User">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/wpf-background.jpg"
                        Stretch="UniformToFill"
                        Opacity="0.25"/>
        </Grid.Background>

        <Rectangle Fill="#CC080D18"/>

        <Border Width="520"
                Height="430"
                Background="#EE101B2D"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Canvas>

                <TextBlock x:Name="TitleText"
                           Canvas.Left="25"
                           Canvas.Top="20"
                           Text="Edit User"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="75"
                           Text="User Name"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="UserNameBox"
                         Canvas.Left="25"
                         Canvas.Top="98"
                         Width="210"
                         Height="34"
                         Padding="8,4"
                         FontSize="13"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"/>

                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=UserNameBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=UserNameBox}"
                           Canvas.Left="25"
                           Canvas.Top="134"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <TextBlock Canvas.Left="285" Canvas.Top="75"
                           Text="Email"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="UserEmailBox"
                         Canvas.Left="285"
                         Canvas.Top="98"
                         Width="210"
                         Height="34"
                         Padding="8,4"
                         FontSize="13"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="150"
                           Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <PasswordBox x:Name="UserPasswordBox"
                             Canvas.Left="25"
                             Canvas.Top="173"
                             Width="210"
                             Height="34"
                             Padding="8,4"
                             FontSize="13"
                             Foreground="White"
                             Background="#CC111827"
                             BorderBrush="#475569"
                             BorderThickness="1"
                             CaretBrush="White"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="210"
                           Text="Leave blank to keep current password"
                           FontSize="11"
                           Foreground="#94A3B8"/>

                <TextBlock Canvas.Left="285" Canvas.Top="150"
                           Text="Phone Number"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="UserPhoneBox"
                         Canvas.Left="285"
                         Canvas.Top="173"
                         Width="210"
                         Height="34"
                         Padding="8,4"
                         FontSize="13"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"/>

                <TextBlock Canvas.Left="25" Canvas.Top="235"
                           Text="Address"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="UserAddressBox"
                         Canvas.Left="25"
                         Canvas.Top="258"
                         Width="210"
                         Height="34"
                         Padding="8,4"
                         FontSize="13"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"/>

                <TextBlock Canvas.Left="285" Canvas.Top="235"
                           Text="City"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="CityBox"
                          Canvas.Left="285"
                          Canvas.Top="258"
                          Width="210"
                          Height="34"
                          Padding="6,4"
                          FontSize="13"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          BorderThickness="1"
                          DisplayMemberPath="CityName"
                          SelectedValuePath="CityId"/>

                <TextBlock Canvas.Left="25" Canvas.Top="315"
                           Text="Manager"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <CheckBox x:Name="ManagerBox"
                          Canvas.Left="25"
                          Canvas.Top="340"
                          Content="Is Manager"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#CBD5E1"/>

                <Button x:Name="AddBtn"
                        Canvas.Left="25"
                        Canvas.Top="375"
                        Content="Edit User"
                        Width="150"
                        Height="36"
                        Background="#16A34A"
                        Foreground="White"
                        BorderBrush="#4ADE80"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="AddBtn_Click"/>

                <Button x:Name="CancelBtn"
                        Canvas.Left="190"
                        Canvas.Top="375"
                        Content="Cancel"
                        Width="110"
                        Height="36"
                        Background="#DC2626"
                        Foreground="White"
                        BorderBrush="#F87171"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelBtn_Click"/>

                <TextBlock x:Name="MessageText"
                           Canvas.Left="320"
                           Canvas.Top="383"
                           Width="175"
                           FontSize="13"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap"/>

            </Canvas>
        </Border>
    </Grid>
</Window>