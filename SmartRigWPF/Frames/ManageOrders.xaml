<UserControl x:Class="SmartRigWPF.Frames.ManageOrders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="10"
                       Canvas.Top="5"
                       Text="Manage Orders"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Canvas.Left="10"
                       Canvas.Top="48"
                       Text="View customer orders and order details"
                       FontSize="14"
                       Foreground="#94A3B8"/>

            <Button Canvas.Left="10"
                    Canvas.Top="85"
                    Content="View Details"
                    Width="140"
                    Height="38"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#60A5FA"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="ViewDetailsBtn_Click"/>

            <ListView x:Name="listView"
                      Canvas.Left="10"
                      Canvas.Top="145"
                      Width="760"
                      Height="340"
                      Background="#99101B2D"
                      Foreground="White"
                      BorderBrush="#314158"
                      BorderThickness="1">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#CC162235"
                                BorderBrush="#314158"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,8"
                                Width="720">

                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White">
                                    <Run Text="Order #"/>
                                    <Run Text="{Binding CartId}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding UserId, StringFormat=User ID: {0}}"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Margin="0,3,0,8"/>

                                <TextBlock Text="{Binding Date, StringFormat=Date: {0}}"
                                           Foreground="#CBD5E1"/>

                                <TextBlock Text="{Binding IsPayed, StringFormat=Paid: {0}}"
                                           Foreground="#22C55E"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Canvas>
    </Grid>
</UserControl>