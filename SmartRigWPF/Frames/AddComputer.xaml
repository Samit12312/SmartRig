<Window x:Class="SmartRigWPF.Frames.AddComputer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Background="#080D18"
        Width="760"
        Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Add Computer">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/wpf-background.jpg"
                        Stretch="UniformToFill"
                        Opacity="0.25"/>
        </Grid.Background>

        <Rectangle Fill="#CC080D18"/>

        <Border Width="720"
                Height="705"
                Background="#EE101B2D"
                BorderBrush="#314158"
                BorderThickness="1"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Canvas>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="20"
                           Text="Add Computer"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <!-- Computer Name -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="70"
                           Text="Computer Name"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="ComputerNameBox"
                         Canvas.Left="25"
                         Canvas.Top="90"
                         Width="205"
                         Height="32"
                         Padding="7,4"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"
                         Text="{Binding Computer.ComputerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="124"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ComputerNameBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=ComputerNameBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Price -->
                <TextBlock Canvas.Left="250"
                           Canvas.Top="70"
                           Text="Price"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBox x:Name="PriceBox"
                         Canvas.Left="250"
                         Canvas.Top="90"
                         Width="205"
                         Height="32"
                         Padding="7,4"
                         Foreground="White"
                         Background="#CC111827"
                         BorderBrush="#475569"
                         BorderThickness="1"
                         CaretBrush="White"
                         Text="{Binding Computer.Price, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="250"
                           Canvas.Top="124"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PriceBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=PriceBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Company -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="145"
                           Text="Company"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="CompanyBox"
                          Canvas.Left="25"
                          Canvas.Top="165"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="CompanyName"
                          SelectedValuePath="CompanyId"
                          SelectedValue="{Binding Computer.CompanyId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="199"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CompanyBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=CompanyBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Type -->
                <TextBlock Canvas.Left="250"
                           Canvas.Top="145"
                           Text="Type"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="TypeBox"
                          Canvas.Left="250"
                          Canvas.Top="165"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="TypeName"
                          SelectedValuePath="TypeId"
                          SelectedValue="{Binding Computer.ComputerTypeId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="250"
                           Canvas.Top="199"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TypeBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=TypeBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Operating System -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="220"
                           Text="Operating System"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="OSBox"
                          Canvas.Left="25"
                          Canvas.Top="240"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="OperatingSystemName"
                          SelectedValuePath="OperatingSystemId"
                          SelectedValue="{Binding Computer.OperatingSystemId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="274"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=OSBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=OSBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- CPU -->
                <TextBlock Canvas.Left="250"
                           Canvas.Top="220"
                           Text="CPU"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="CpuBox"
                          Canvas.Left="250"
                          Canvas.Top="240"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="CpuName"
                          SelectedValuePath="CpuId"
                          SelectedValue="{Binding Computer.CpuId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="250"
                           Canvas.Top="274"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CpuBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=CpuBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- GPU -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="295"
                           Text="GPU"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="GpuBox"
                          Canvas.Left="25"
                          Canvas.Top="315"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="GpuName"
                          SelectedValuePath="GpuId"
                          SelectedValue="{Binding Computer.GpuId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="349"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=GpuBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=GpuBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- RAM -->
                <TextBlock Canvas.Left="250"
                           Canvas.Top="295"
                           Text="RAM"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="RamBox"
                          Canvas.Left="250"
                          Canvas.Top="315"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="RamSize"
                          SelectedValuePath="RamId"
                          SelectedValue="{Binding Computer.RamId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="250"
                           Canvas.Top="349"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=RamBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=RamBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Storage -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="370"
                           Text="Storage"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="StorageBox"
                          Canvas.Left="25"
                          Canvas.Top="390"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="StorageName"
                          SelectedValuePath="StorageId"
                          SelectedValue="{Binding Computer.StorageId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="424"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=StorageBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=StorageBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Motherboard -->
                <TextBlock Canvas.Left="250"
                           Canvas.Top="370"
                           Text="Motherboard"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="MotherboardBox"
                          Canvas.Left="250"
                          Canvas.Top="390"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="MotherBoardName"
                          SelectedValuePath="MotherBoardId"
                          SelectedValue="{Binding Computer.MotherBoardId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="250"
                           Canvas.Top="424"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=MotherboardBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=MotherboardBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Case -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="445"
                           Text="Case"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="CaseBox"
                          Canvas.Left="25"
                          Canvas.Top="465"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="CaseName"
                          SelectedValuePath="CaseId"
                          SelectedValue="{Binding Computer.CaseId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="499"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CaseBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=CaseBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Power Supply -->
                <TextBlock Canvas.Left="250"
                           Canvas.Top="445"
                           Text="Power Supply"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="PowerSupplyBox"
                          Canvas.Left="250"
                          Canvas.Top="465"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="PowerSupplyName"
                          SelectedValuePath="PowerSupplyId"
                          SelectedValue="{Binding Computer.PowerSupplyId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="250"
                           Canvas.Top="499"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PowerSupplyBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=PowerSupplyBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- CPU Fan -->
                <TextBlock Canvas.Left="25"
                           Canvas.Top="520"
                           Text="CPU Fan"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <ComboBox x:Name="CpuFanBox"
                          Canvas.Left="25"
                          Canvas.Top="540"
                          Width="205"
                          Height="32"
                          Padding="5,3"
                          Foreground="#111827"
                          Background="#E5EAF3"
                          BorderBrush="#475569"
                          DisplayMemberPath="CpuFanName"
                          SelectedValuePath="CpuFanId"
                          SelectedValue="{Binding Computer.CpuFanId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <TextBlock Canvas.Left="25"
                           Canvas.Top="574"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CpuFanBox}"
                           Visibility="{Binding (Validation.HasError), Converter={StaticResource BoolToVis}, ElementName=CpuFanBox}"
                           Foreground="#FCA5A5"
                           FontSize="11"/>

                <!-- Image Box -->
                <TextBlock Canvas.Left="490"
                           Canvas.Top="70"
                           Text="Computer Image"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <Border Canvas.Left="490"
                        Canvas.Top="95"
                        Width="190"
                        Height="190"
                        Background="#66111827"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">

                    <Image x:Name="image"
                           Width="165"
                           Height="165"
                           Stretch="Uniform"/>
                </Border>

                <Button x:Name="UploadImageBtn"
                        Canvas.Left="510"
                        Canvas.Top="305"
                        Content="Upload Image"
                        Width="150"
                        Height="34"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#60A5FA"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="UploadImageBtn_Click"/>

                <TextBlock x:Name="MessageText"
                           Canvas.Left="490"
                           Canvas.Top="355"
                           Width="190"
                           FontSize="13"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap"/>

                <!-- Buttons -->
                <Button x:Name="AddBtn"
                        Canvas.Left="25"
                        Canvas.Top="630"
                        Content="Add Computer"
                        Width="155"
                        Height="38"
                        Background="#16A34A"
                        Foreground="White"
                        BorderBrush="#4ADE80"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="AddBtn_Click"/>

                <Button x:Name="CancelBtn"
                        Canvas.Left="195"
                        Canvas.Top="630"
                        Content="Cancel"
                        Width="110"
                        Height="38"
                        Background="#DC2626"
                        Foreground="White"
                        BorderBrush="#F87171"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelBtn_Click"/>

            </Canvas>
        </Border>
    </Grid>
</Window>