@model Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}

<link href="~/stylesheet/checkout.css" rel="stylesheet" />
<script>
    function FormatCardDate(input) {
        let value = input.value.replace(/\D/g, "");

        if (value.length > 4) {
            value = value.substring(0, 4);
        }

        if (value.length >= 2) {
            value = value.substring(0, 2) + "/" + value.substring(2);
        }

        input.value = value;
    }
</script>
<div class="checkout-container">
    <h2>Checkout</h2>

    @if (ViewBag.Message != null)
    {
        <div class="error-message">
            @ViewBag.Message
        </div>
    }

    <form asp-controller="User" asp-action="Checkout" method="post" class="checkout-form">

        <div class="field">
            <label asp-for="CardHolderName">Card Holder Name</label>
            <input asp-for="CardHolderName"
                   placeholder="Card Holder Name"
                   maxlength="40"
                   autocomplete="off"
                   oninput="OnlyName(this)" />
            <span asp-validation-for="CardHolderName" class="error-message"></span>
        </div>

        <div class="field">
            <label asp-for="CardNumber">Card Number</label>
            <input asp-for="CardNumber"
                   placeholder="16 digits"
                   maxlength="16"
                   autocomplete="off"
                   inputmode="numeric"
                   oninput="OnlyDigits(this, 16)" />
            <span asp-validation-for="CardNumber" class="error-message"></span>
        </div>

        <div class="field-row">
            <div class="field small-field">
                <label asp-for="CardDate">Card Date</label>
                <input asp-for="CardDate"
                       id="cardDate"
                       placeholder="MM/YY"
                       maxlength="5"
                       autocomplete="off"
                       inputmode="numeric"
                       oninput="FormatCardDate(this)" />
                <span asp-validation-for="CardDate" class="error-message"></span>
            </div>

            <div class="field small-field">
                <label asp-for="Cvv">CVV</label>
                <input asp-for="Cvv"
                       placeholder="CVV"
                       maxlength="3"
                       autocomplete="off"
                       inputmode="numeric"
                       oninput="OnlyDigits(this, 3)" />
                <span asp-validation-for="Cvv" class="error-message"></span>
            </div>
        </div>

        <div class="field">
            <label asp-for="Address">Address</label>
            <input asp-for="Address"
                   placeholder="Shipping address"
                   maxlength="80"
                   autocomplete="off"
                   oninput="CleanAddress(this)" />
            <span asp-validation-for="Address" class="error-message"></span>
        </div>

        <button type="submit" class="checkout-btn">Pay Now</button>

        <a href="~/User/ViewCart" class="back-link">Back to Cart</a>
    </form>
    <script>
        function OnlyName(input) {
            input.value = input.value.replace(/[^A-Za-zא-ת ]/g, "");
        }

        function OnlyDigits(input, maxLength) {
            let value = input.value.replace(/\D/g, "");

            if (value.length > maxLength) {
                value = value.substring(0, maxLength);
            }

            input.value = value;
        }

        function FormatCardDate(input) {
            let value = input.value.replace(/\D/g, "");

            if (value.length > 4) {
                value = value.substring(0, 4);
            }

            if (value.length >= 2) {
                value = value.substring(0, 2) + "/" + value.substring(2);
            }

            input.value = value;
        }

        function CleanAddress(input) {
            input.value = input.value.replace(/[^A-Za-zא-ת0-9 ,.'/-]/g, "");
        }
    </script>
</div>