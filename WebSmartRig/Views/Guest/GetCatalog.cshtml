@using Models
@model CatalogViewModel

@{
    ViewData["Title"] = "ComputersCatalog";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}

<link rel="stylesheet" href="~/StyleSheet/ComputerCatalog.css" />

@if (TempData["Message"] != null)
{
    <div class="success-message">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="success-message">
        @TempData["Error"]
    </div>
}

<div class="catalog-container">

    <form method="get" asp-controller="Guest" asp-action="GetCatalog" class="filters">

        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        <h3>Computer Type</h3>

        <select name="typeId" onchange="this.form.submit()">
            @if (Model.TypeId == null)
            {
                <option value="" selected="selected">All Types</option>
            }
            else
            {
                <option value="">All Types</option>
            }

            @if (Model.Types != null)
            {
                foreach (Models.Type type in Model.Types)
                {
                    if (Model.TypeId == type.TypeId)
                    {
                        <option value="@type.TypeId" selected="selected">@type.TypeName</option>
                    }
                    else
                    {
                        <option value="@type.TypeId">@type.TypeName</option>
                    }
                }
            }
        </select>

        <h3>Company</h3>

        <select name="companyId" onchange="this.form.submit()">
            @if (Model.CompanyId == null)
            {
                <option value="" selected="selected">All Companies</option>
            }
            else
            {
                <option value="">All Companies</option>
            }

            @if (Model.Companys != null)
            {
                foreach (Company company in Model.Companys)
                {
                    if (Model.CompanyId == company.CompanyId)
                    {
                        <option value="@company.CompanyId" selected="selected">@company.CompanyName</option>
                    }
                    else
                    {
                        <option value="@company.CompanyId">@company.CompanyName</option>
                    }
                }
            }
        </select>

        <h3>Operating System</h3>

        <select name="operatingSystemId" onchange="this.form.submit()">
            @if (Model.OperatingSystemId == null)
            {
                <option value="" selected="selected">All OS</option>
            }
            else
            {
                <option value="">All OS</option>
            }

            @if (Model.OperatingSystemId == 8)
            {
                <option value="8" selected="selected">Windows</option>
            }
            else
            {
                <option value="8">Windows</option>
            }

            @if (Model.OperatingSystemId == 9)
            {
                <option value="9" selected="selected">Linux</option>
            }
            else
            {
                <option value="9">Linux</option>
            }

            @if (Model.OperatingSystemId == 10)
            {
                <option value="10" selected="selected">Ubuntu</option>
            }
            else
            {
                <option value="10">Ubuntu</option>
            }
        </select>

        <h3>Price Range</h3>

        <label>Minimum Price</label>
        <input type="number" name="minPrice" value="@Model.MinPrice" />

        <label>Maximum Price</label>
        <input type="number" name="maxPrice" value="@Model.MaxPrice" />

        <button type="submit" class="filter-btn">Apply Price</button>

        <a class="clear-price-btn"
           asp-controller="Guest"
           asp-action="GetCatalog"
           asp-route-typeId="@Model.TypeId"
           asp-route-companyId="@Model.CompanyId"
           asp-route-operatingSystemId="@Model.OperatingSystemId"
           asp-route-priceSort="@Model.PriceSort"
           asp-route-currencyCode="@Model.CurrencyCode"
           asp-route-page="1"
           asp-route-pageSize="@Model.PageSize">
            Clear Price
        </a>

        <h3>Currency</h3>

        <select name="currencyCode" onchange="this.form.submit()">
            @if (Model.Currencies != null)
            {
                foreach (KeyValuePair<string, string> item in Model.Currencies)
                {
                    if (Model.CurrencyCode == item.Key)
                    {
                        <option value="@item.Key" selected="selected">@item.Key - @item.Value</option>
                    }
                    else
                    {
                        <option value="@item.Key">@item.Key - @item.Value</option>
                    }
                }
            }
        </select>

        <h3>Sort by Price</h3>

        <label class="sort-option">
            @if (Model.PriceSort == 1)
            {
                <input type="radio" name="priceSort" value="1" checked="checked" onchange="this.form.submit()" />
            }
            else
            {
                <input type="radio" name="priceSort" value="1" onchange="this.form.submit()" />
            }

            <span>Low to High</span>
        </label>

        <label class="sort-option">
            @if (Model.PriceSort == 2)
            {
                <input type="radio" name="priceSort" value="2" checked="checked" onchange="this.form.submit()" />
            }
            else
            {
                <input type="radio" name="priceSort" value="2" onchange="this.form.submit()" />
            }

            <span>High to Low</span>
        </label>

    </form>

    <div class="catalog-results">

        <div class="computers">

            @if (Model.Computers == null || Model.Computers.Count == 0)
            {
                <h2>No computers found</h2>
            }
            else
            {
                foreach (ComputerCatalogViewModel computer in Model.Computers)
                {
                    <div class="computer-card">

                        <a asp-controller="Guest"
                           asp-action="GetComputer"
                           asp-route-computerId="@computer.Id">
                            <img src="http://localhost:5195/Images/Computers/@computer.ComputerPicture" alt="@computer.ComputerName" />
                        </a>

                        <h1>@computer.ComputerName</h1>

                        <p>
                            CPU: @computer.Cpu<br />
                            GPU: @computer.Gpu<br />
                            RAM: @computer.Ram<br />
                            Storage: @computer.Storage<br />
                            OS: @computer.OperatingSystem
                        </p>

                        <div class="card-bottom">
                            <span class="price">@Model.CurrencySymbol@computer.DisplayPrice.ToString("0.00")</span>

                            <a class="cartButton"
                               asp-controller="User"
                               asp-action="AddToCart"
                               asp-route-computerId="@computer.Id">
                                Add to Cart
                            </a>
                        </div>

                    </div>
                }
            }

        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination-box">

                @if (Model.HasPreviousPage)
                {
                    <a class="page-btn"
                       asp-controller="Guest"
                       asp-action="GetCatalog"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-typeId="@Model.TypeId"
                       asp-route-companyId="@Model.CompanyId"
                       asp-route-operatingSystemId="@Model.OperatingSystemId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-priceSort="@Model.PriceSort"
                       asp-route-currencyCode="@Model.CurrencyCode">
                        Previous
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.Page)
                    {
                        <span class="page-btn active">@i</span>
                    }
                    else
                    {
                        <a class="page-btn"
                           asp-controller="Guest"
                           asp-action="GetCatalog"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-typeId="@Model.TypeId"
                           asp-route-companyId="@Model.CompanyId"
                           asp-route-operatingSystemId="@Model.OperatingSystemId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-priceSort="@Model.PriceSort"
                           asp-route-currencyCode="@Model.CurrencyCode">
                            @i
                        </a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a class="page-btn"
                       asp-controller="Guest"
                       asp-action="GetCatalog"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-typeId="@Model.TypeId"
                       asp-route-companyId="@Model.CompanyId"
                       asp-route-operatingSystemId="@Model.OperatingSystemId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-priceSort="@Model.PriceSort"
                       asp-route-currencyCode="@Model.CurrencyCode">
                        Next
                    </a>
                }

            </div>
        }

    </div>

</div>